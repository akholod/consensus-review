{
  "name": "consensus-review",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "description": "Runtime for the /loop-review command. The plugin itself is markdown; this package carries only the deterministic loop runtime and its tests.",
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test",
    "check:contracts": "node scripts/gen-contracts.mjs --check",
    "check:compat": "node scripts/compat-check.mjs",
    "lint:prompts": "node scripts/lint-prompts.mjs",
    "doctor": "node scripts/doctor.mjs",
    "doctor:offline": "node scripts/doctor.mjs --offline",
    "check:all": "node --test && node scripts/gen-contracts.mjs --check && node scripts/lint-prompts.mjs"
  },
  "license": "MIT"
}
