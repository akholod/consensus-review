{
  "name": "consensus-review",
  "version": "0.11.0",
  "description": "Code review for Claude Code that a second model has to agree with: a parallel panel with codex as consultant, or sequential coverage-directed passes. Read-only, P0-P2 with evidence.",
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "code-review",
    "consensus",
    "codex",
    "multi-agent",
    "review"
  ],
  "author": "akholod",
  "license": "MIT",
  "homepage": "https://github.com/akholod/consensus-review#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akholod/consensus-review.git"
  },
  "bugs": {
    "url": "https://github.com/akholod/consensus-review/issues"
  },
  "type": "module",
  "files": [
    ".claude-plugin",
    "agents",
    "commands",
    "prompts",
    "contracts",
    "bin",
    "src",
    "scripts",
    "docs/*.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test",
    "check:contracts": "node scripts/gen-contracts.mjs --check",
    "check:compat": "node scripts/compat-check.mjs",
    "lint:prompts": "node scripts/lint-prompts.mjs",
    "doctor": "node scripts/doctor.mjs",
    "doctor:offline": "node scripts/doctor.mjs --offline",
    "check:all": "node --test && node scripts/gen-contracts.mjs --check && node scripts/lint-prompts.mjs",
    "prepublishOnly": "npm run check:all"
  }
}
