@@ -0,0 +1,18 @@
+export class Order {
+  constructor(lines) {
+    this.lines = lines
+    this.status = "open"
+    this.releasedSkus = []
+  }
+
+  // An open order can be cancelled, which returns its units to stock; a shipped one cannot.
+  cancel() {
+    if (this.status === "shipped") throw new Error("cannot cancel a shipped order")
+    this.status = "cancelled"
+    this._releaseStock()
+  }
+
+  _releaseStock() {
+    this.releasedSkus = this.lines.map((line) => line.sku)
+  }
+}
