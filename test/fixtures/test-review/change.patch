@@ -0,0 +1,21 @@
+export class InvalidCouponError extends Error {
+  constructor(code) {
+    super(`invalid coupon: ${code}`)
+    this.name = "InvalidCouponError"
+  }
+}
+
+const COUPON_FORMAT = /^[A-Z]{4}\d{2}$/
+
+// "SAVE10" -> 10 % off.
+export function parseCoupon(code) {
+  if (!COUPON_FORMAT.test(code)) {
+    throw new InvalidCouponError(code)
+  }
+  return { code, percent: Number(code.slice(4)) }
+}
+
+// expiresAt is a timestamp in milliseconds; a coupon is expired from that instant on.
+export function isExpired(coupon) {
+  return coupon.expiresAt <= Date.now()
+}
