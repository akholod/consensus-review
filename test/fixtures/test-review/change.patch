+// Units a customer can still buy: stock on hand minus units held for open carts.
+export function availableUnits(sku, { stock, holds }) {
+  const onHand = stock.onHand(sku)
+  const held = holds.heldFor(sku)
+  return Math.max(0, onHand - held)
+}
