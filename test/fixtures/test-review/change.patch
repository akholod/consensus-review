@@ -0,0 +1,8 @@
+import { formatCents } from "./money.js"
+
+export function formatReceipt(order) {
+  const lines = order.items.map((item) => `${item.name} x${item.qty}  ${formatCents(item.priceCents * item.qty)}`)
+  const total = order.items.reduce((sum, item) => sum + item.priceCents * item.qty, 0)
+  lines.push(`Total: ${formatCents(total)}`)
+  return lines
+}
