@@ -0,0 +1,8 @@
+// Opened items are refunded minus a 15 % restocking fee, rounded to the cent; unopened items in full.
+export function restockingFee(cents) {
+  return Math.round(cents * 0.15)
+}
+
+export function refundFor(item) {
+  return item.opened ? item.priceCents - restockingFee(item.priceCents) : item.priceCents
+}
