+export const GOLD_THRESHOLD_CENTS = 20000
+
+// One point per whole currency unit.
+export function basePoints(cents) {
+  return Math.floor(cents / 100)
+}
+
+// Orders of 20000 cents or more earn double points.
+export function pointsFor(order) {
+  const points = basePoints(order.totalCents)
+  return order.totalCents >= GOLD_THRESHOLD_CENTS ? points * 2 : points
+}
