+// A bundle of three or more items gets 10 % off its sum, rounded down to the cent.
+export function priceBundle(items) {
+  const sum = items.reduce((acc, item) => acc + item.priceCents, 0)
+  const discountCents = items.length >= 3 ? Math.floor(sum / 10) : 0
+  return { sum, discountCents, totalCents: sum - discountCents }
+}
