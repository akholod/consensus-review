+++ b/test/reviews.test.js
@@ -0,0 +1,28 @@
+import { test } from "node:test"
+import assert from "node:assert/strict"
+import { addReview } from "../src/reviews.js"
+import { DuplicateReviewError } from "../src/store.js"
+
+function memoryStore() {
+  const rows = []
+  return {
+    insertReview(review) {
+      if (rows.some((row) => row.productId === review.productId && row.userId === review.userId)) {
+        throw new DuplicateReviewError(review.productId, review.userId)
+      }
+      rows.push(review)
+      return review
+    },
+    reviewsFor: (productId) => rows.filter((row) => row.productId === productId),
+  }
+}
+
+test("a user cannot review the same product twice", () => {
+  const store = memoryStore()
+  addReview(store, { productId: "p-1", userId: "u-1", stars: 5, text: "great" })
+
+  assert.throws(
+    () => addReview(store, { productId: "p-1", userId: "u-1", stars: 1, text: "changed my mind" }),
+    DuplicateReviewError,
+  )
+})
