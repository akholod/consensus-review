+export class InsufficientBalanceError extends Error {
+  constructor(cardId, cents) {
+    super(`card ${cardId} cannot cover ${cents}`)
+    this.name = "InsufficientBalanceError"
+  }
+}
+
+// Redeeming more than the card's balance is refused.
+export async function redeem(card, cents) {
+  if (cents > card.balanceCents) {
+    throw new InsufficientBalanceError(card.id, cents)
+  }
+  return { ...card, balanceCents: card.balanceCents - cents }
+}
