+++ b/src/cart.js
@@ -0,0 +1,19 @@
+export class Cart {
+  constructor() {
+    this._lines = []
+    this.totalCents = 0
+  }
+
+  add(sku, qty, priceCents) {
+    this._lines.push({ sku, qty, priceCents })
+    this._recalculate()
+  }
+
+  get count() {
+    return this._lines.reduce((sum, line) => sum + line.qty, 0)
+  }
+
+  _recalculate() {
+    this.totalCents = this._lines.reduce((sum, line) => sum + line.qty * line.priceCents, 0)
+  }
+}
