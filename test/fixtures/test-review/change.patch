+export const DEPOSIT_RATE = 0.3
+
+// Made-to-order items take a 30 % deposit, rounded up to the cent; the balance is due on delivery.
+export function splitPayment(cents) {
+  const deposit = Math.ceil(cents * DEPOSIT_RATE)
+  return { deposit, balance: cents - deposit }
+}
