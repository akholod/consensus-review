@@ -0,0 +1,17 @@
+// In-memory review store.
+export function insertReview(rows, review) {
+  rows.push({ ...review })
+  return review
+}
+
+export function reviewsFor(rows, productId) {
+  return rows.filter((row) => row.productId === productId)
+}
+
+export function makeStore() {
+  const rows = []
+  return {
+    insertReview: (review) => insertReview(rows, review),
+    reviewsFor: (productId) => reviewsFor(rows, productId),
+  }
+}
