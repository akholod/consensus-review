+// Slugs for titles created before the current URL scheme.
+export function legacySlug(title) {
+  const dashed = title.toLowerCase().replace(/[^a-z0-9]+/g, "-")
+  const trimmed = dashed.replace(/^-+|-+$/g, "")
+  return trimmed.slice(0, 12)
+}
