+import { balanceOf } from "../billing/index.js"
+import { authorize } from "./gateway.js"
+
+export const FEES = { refundCents: 50 }
+
+/** Charges the customer's open balance. `amount` is the charged amount in cents. */
+export async function charge(customerId) {
+  const amount = balanceOf(customerId)
+  const { authorizationId } = await authorize({ customerId, amount })
+  return { authorizationId, amount }
+}
