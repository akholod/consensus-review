--- /dev/null
+++ b/src/billing/issue.js
@@ -0,0 +1,22 @@
+import { getCustomer } from "../customers/index.js"
+import { publish } from "../infra/bus.js"
+import { insert, query } from "../infra/db.js"
+
+const customerOf = new Map()
+
+export function trackOrder(orderId, customerId) {
+  customerOf.set(orderId, customerId)
+}
+
+export function findInvoice(orderId) {
+  return query("invoices", { orderId })[0] ?? null
+}
+
+export function issueInvoice(orderId) {
+  const customerId = customerOf.get(orderId)
+  const customer = getCustomer(customerId)
+  const invoiceId = `inv_${query("invoices").length + 1}`
+  insert("invoices", { invoiceId, orderId, customerId, email: customer?.email ?? null, voided: false })
+  publish("invoice.issued", { version: 1, invoiceId, orderId, customerId })
+  return invoiceId
+}
diff --git a/src/catalog/index.js b/src/catalog/index.js
new file mode 100644
