@@ -0,0 +1,16 @@
+// Browser-code boundary from docs/architecture.md, rule 1. CI runs `npm run lint`.
+const SERVER_MODULES = ["orders", "billing", "payments", "catalog", "checkout", "shipping", "customers", "reports"]
+
+export default [
+  {
+    files: ["src/ui/**/*.js"],
+    rules: {
+      "no-restricted-imports": ["error", {
+        patterns: [
+          { group: ["**/infra/**"], message: "Browser code never imports server infrastructure." },
+          { group: SERVER_MODULES.map((m) => `**/${m}/**`), message: "Browser code talks to the server only through src/generated." },
+        ],
+      }],
+    },
+  },
+]
