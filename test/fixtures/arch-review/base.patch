@@ -0,0 +1,7 @@
+import { rateFor } from "./internal/rates.js"
+
+/** Shipping cost in cents: one parcel per five units. */
+export function quote(country, items) {
+  const units = items.reduce((n, i) => n + i.qty, 0)
+  return rateFor(country) * Math.ceil(units / 5)
+}
