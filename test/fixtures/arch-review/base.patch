@@ -0,0 +1,22 @@
+import { subscribe } from "../infra/bus.js"
+import { ledgerFor } from "./internal/ledger.js"
+import { findInvoice, issueInvoice, trackOrder } from "./issue.js"
+
+subscribe("order.placed", ({ orderId, customerId, total }) => {
+  trackOrder(orderId, customerId)
+  ledgerFor(customerId).add({ orderId, amount: total })
+})
+
+subscribe("order.updated", ({ orderId, status }) => {
+  if (status === "paid" && !findInvoice(orderId)) issueInvoice(orderId)
+})
+
+export { findInvoice, issueInvoice }
+
+export function balanceOf(customerId) {
+  return ledgerFor(customerId).balance()
+}
+
+export function voidCharge(customerId, orderId) {
+  ledgerFor(customerId).void(orderId)
+}
diff --git a/src/billing/internal/ledger.js b/src/billing/internal/ledger.js
new file mode 100644
index 0000000..1877f84
--- /dev/null
+++ b/src/billing/internal/ledger.js
@@ -0,0 +1,24 @@
+class Ledger {
+  constructor() {
+    this._entries = []
+  }
+
+  add(entry) {
+    this._entries.push({ ...entry, voided: false })
+  }
+
+  void(orderId) {
+    for (const entry of this._entries) if (entry.orderId === orderId) entry.voided = true
+  }
+
+  balance() {
+    return this._entries.filter((e) => !e.voided).reduce((sum, e) => sum + e.amount, 0)
+  }
+}
+
+const ledgers = new Map()
+
+export function ledgerFor(customerId) {
+  if (!ledgers.has(customerId)) ledgers.set(customerId, new Ledger())
+  return ledgers.get(customerId)
+}
diff --git a/src/billing/issue.js b/src/billing/issue.js
new file mode 100644
