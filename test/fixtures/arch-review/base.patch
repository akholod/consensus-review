@@ -0,0 +1,13 @@
+import { config } from "../infra/config.js"
+
+const holds = new Map()
+
+/** Holds the items while the payment is authorised; the hold lapses with the payment timeout. */
+export function holdStock(orderId, items) {
+  holds.set(orderId, items)
+  setTimeout(() => holds.delete(orderId), config.paymentTimeoutMs).unref()
+}
+
+export function heldItems(orderId) {
+  return holds.get(orderId) ?? []
+}
