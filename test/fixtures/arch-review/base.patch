@@ -0,0 +1,11 @@
+const RATES = [
+  { country: "DE", cents: 490 },
+  { country: "FR", cents: 690 },
+  { country: "NL", cents: 590 },
+]
+
+export function rateFor(country) {
+  const rate = RATES.find((r) => r.country === country)
+  if (!rate) throw new Error(`no shipping to ${country}`)
+  return rate.cents
+}
