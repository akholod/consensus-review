--- /dev/null
+++ b/src/generated/orders-client.js
@@ -0,0 +1,29 @@
+// Generated by `npm run gen` from openapi.yaml. Do not edit.
+
+/**
+ * @typedef {object} Order
+ * @property {string} id
+ * @property {"unpaid" | "paid" | "refunded"} status
+ * @property {number} total Order total in cents.
+ * @property {{ sku: string, qty: number, priceCents: number }[]} items
+ */
+
+export async function fetchOrder(id, { baseUrl = "" } = {}) {
+  const res = await fetch(`${baseUrl}/v1/orders/${encodeURIComponent(id)}`)
+  if (!res.ok) throw new Error(`GET /v1/orders/${id}: ${res.status}`)
+  return res.json()
+}
+
+/** @returns {Order} */
+export function parseOrder(json) {
+  if (typeof json?.id !== "string") throw new TypeError("Order.id: expected a string")
+  if (!["unpaid", "paid", "refunded"].includes(json.status)) throw new TypeError(`Order.status: unexpected ${json.status}`)
+  if (!Number.isInteger(json.total)) throw new TypeError("Order.total: expected integer cents")
+  if (!Array.isArray(json.items)) throw new TypeError("Order.items: expected an array")
+  return {
+    id: json.id,
+    status: json.status,
+    total: json.total,
+    items: json.items.map((i) => ({ sku: i.sku, qty: i.qty, priceCents: i.priceCents })),
+  }
+}
diff --git a/src/infra/bus.js b/src/infra/bus.js
new file mode 100644
index 0000000..c86e38a
--- /dev/null
+++ b/src/infra/bus.js
@@ -0,0 +1,10 @@
+const handlers = new Map()
+
+export function subscribe(type, handler) {
+  if (!handlers.has(type)) handlers.set(type, [])
+  handlers.get(type).push(handler)
+}
+
+export function publish(type, payload) {
+  for (const handler of handlers.get(type) ?? []) handler(payload)
+}
