+import { insert, query } from "../infra/db.js"
+import { normaliseEmail, profileCache } from "./internal/profiles.js"
+
+export function createCustomer({ name, email }) {
+  const id = `cus_${query("customers").length + 1}`
+  insert("customers", { id, name, email: normaliseEmail(email) })
+  return id
+}
+
+export function getCustomer(id) {
+  if (!profileCache.has(id)) {
+    const [row] = query("customers", { id })
+    if (!row) return null
+    profileCache.set(id, { id: row.id, name: row.name, email: row.email })
+  }
+  return { ...profileCache.get(id) }
+}
