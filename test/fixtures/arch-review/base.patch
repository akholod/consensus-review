@@ -0,0 +1,41 @@
+import { publish } from "../infra/bus.js"
+import { holdStock } from "./reserve.js"
+import { findByCustomer, findOrder, patchOrder, saveOrder } from "./store.js"
+
+class OrderView {
+  constructor(row) {
+    this._row = row
+  }
+  get id() { return this._row.id }
+  get status() { return this._row.status }
+  get total() { return this._row.total }
+  get items() { return this._row.items.map((i) => ({ ...i })) }
+}
+
+let seq = 0
+
+export function placeOrder({ customerId, items, total }) {
+  const id = `ord_${++seq}`
+  saveOrder({ id, customerId, items, total, status: "unpaid", deletedAt: null })
+  holdStock(id, items)
+  publish("order.placed", { version: 1, orderId: id, customerId, total })
+  return id
+}
+
+export function getOrder(id) {
+  const row = findOrder(id)
+  return row && !row.deletedAt ? new OrderView(row) : null
+}
+
+export function listOrders(customerId) {
+  return findByCustomer(customerId).filter((row) => !row.deletedAt).map((row) => new OrderView(row))
+}
+
+export function updateStatus(id, status) {
+  patchOrder(id, { status })
+  publish("order.updated", { version: 1, orderId: id, status })
+}
+
+export function deleteOrder(id) {
+  patchOrder(id, { deletedAt: new Date().toISOString() })
+}
