+import { fetchOrder, parseOrder } from "../generated/orders-client.js"
+import { formatCents } from "./format.js"
+
+export async function renderOrderPage(id) {
+  const order = parseOrder(await fetchOrder(id))
+  const lines = order.items.map((i) => `<li>${i.sku} × ${i.qty}</li>`)
+  return `<h1>Order ${order.id}</h1><p>${order.status}</p><ul>${lines.join("")}</ul><p>Total ${formatCents(order.total)}</p>`
+}
