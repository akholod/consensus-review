--- /dev/null
+++ b/src/checkout/index.js
@@ -0,0 +1,14 @@
+import { getPrice } from "../catalog/index.js"
+import { placeOrder } from "../orders/index.js"
+import { charge } from "../payments/index.js"
+import { quote } from "../shipping/index.js"
+import { validateCart } from "./validate.js"
+
+export async function checkout({ customerId, items, country }) {
+  validateCart(items)
+  const priced = items.map((i) => ({ ...i, priceCents: getPrice(i.sku) }))
+  const total = priced.reduce((sum, i) => sum + i.priceCents * i.qty, 0) + quote(country, items)
+  const orderId = placeOrder({ customerId, items: priced, total })
+  const { authorizationId, amount } = await charge(customerId)
+  return { orderId, authorizationId, paidCents: amount }
+}
