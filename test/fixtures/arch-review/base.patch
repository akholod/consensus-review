--- /dev/null
+++ b/src/catalog/index.js
@@ -0,0 +1,18 @@
+import { query } from "../infra/db.js"
+
+const cache = new Map()
+
+/** Price of a product in cents. */
+export function getPrice(sku) {
+  if (!cache.has(sku)) {
+    const [row] = query("products", { sku })
+    if (!row) throw new Error(`unknown sku ${sku}`)
+    cache.set(sku, row.priceCents)
+  }
+  return cache.get(sku)
+}
+
+export function getProduct(sku) {
+  const [row] = query("products", { sku })
+  return row ? { sku: row.sku, name: row.name, priceCents: getPrice(sku), tags: [...row.tags] } : null
+}
