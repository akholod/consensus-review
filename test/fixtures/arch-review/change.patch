diff --git a/src/ui/receipt.js b/src/ui/receipt.js
new file mode 100644
index 0000000..029da5e
--- /dev/null
+++ b/src/ui/receipt.js
@@ -0,0 +1,16 @@
+import { fetchOrder } from "../generated/orders-client.js"
+import { formatCents } from "./format.js"
+
+/**
+ * @typedef {object} ReceiptOrder
+ * @property {string} id
+ * @property {number} total
+ * @property {{ sku: string, qty: number, price: number }[]} items
+ */
+
+export async function renderReceipt(id) {
+  /** @type {ReceiptOrder} */
+  const order = await fetchOrder(id)
+  const lines = order.items.map((i) => `<li>${i.sku} × ${i.qty}: ${formatCents(i.price * i.qty)}</li>`)
+  return `<ul>${lines.join("")}</ul><p>Total ${formatCents(order.total)}</p>`
+}
