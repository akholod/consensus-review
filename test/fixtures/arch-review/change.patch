@@ -0,0 +1,7 @@
+import { getPrice, priceTable } from "../catalog/index.js"
+
+/** Starts a flash sale: the listed products cost `percentOff` percent less from now on. */
+export function startFlashSale(skus, percentOff) {
+  const prices = priceTable()
+  for (const sku of skus) prices.set(sku, Math.round((getPrice(sku) * (100 - percentOff)) / 100))
+}
