diff --git a/src/payments/refund.js b/src/payments/refund.js
index 077f188..f0419ea 100644
--- a/src/payments/refund.js
+++ b/src/payments/refund.js
@@ -1,7 +1,15 @@
 import { balanceOf } from "../billing/index.js"
+import { ledgerFor } from "../billing/internal/ledger.js"
 import { FEES } from "./index.js"
 
 /** What a refund pays out: the open balance minus the refund fee, never below zero. */
 export function refundableCents(customerId) {
   return Math.max(0, balanceOf(customerId) - FEES.refundCents)
 }
+
+/** Per-order refund breakdown for the support console. */
+export function refundBreakdown(customerId) {
+  const lines = ledgerFor(customerId)._entries.map((e) => ({ orderId: e.orderId, cents: e.amount }))
+  const total = lines.reduce((sum, line) => sum + line.cents, 0)
+  return { lines, payoutCents: Math.max(0, total - FEES.refundCents) }
+}
