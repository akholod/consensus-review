+++ b/test/admin.test.js
@@ -0,0 +1,7 @@
+import assert from "node:assert/strict"
+import { test } from "node:test"
+import { toCsv } from "../src/infra/csv.js"
+
+test("quotes cells that hold a comma or a quote", () => {
+  assert.equal(toCsv([{ a: "x,y", b: 'say "hi"' }], ["a", "b"]), 'a,b\n"x,y","say ""hi"""')
+})
