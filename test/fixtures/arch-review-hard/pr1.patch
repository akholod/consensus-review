--- /dev/null
+++ b/src/api/admin-handler.js
@@ -0,0 +1,10 @@
+import { exportActiveCsv } from "../admin/index.js"
+import { toResponse } from "./errors.js"
+
+export function getActiveExportHandler() {
+  try {
+    return { status: 200, headers: { "content-type": "text/csv" }, body: exportActiveCsv() }
+  } catch (err) {
+    return toResponse(err)
+  }
+}
diff --git a/src/infra/csv.js b/src/infra/csv.js
new file mode 100644
index 0000000..2343157
--- /dev/null
+++ b/src/infra/csv.js
@@ -0,0 +1,8 @@
+const cell = (value) => {
+  const text = String(value ?? "")
+  return /[",\n]/.test(text) ? `"${text.replace(/"/g, '""')}"` : text
+}
+
+export function toCsv(rows, columns) {
+  return [columns.join(","), ...rows.map((row) => columns.map((c) => cell(row[c])).join(","))].join("\n")
+}
