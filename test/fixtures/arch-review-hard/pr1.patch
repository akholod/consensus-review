--- /dev/null
+++ b/src/admin/export.js
@@ -0,0 +1,9 @@
+import { toCsv } from "../infra/csv.js"
+import { allSubscriptions } from "../subscriptions/repository.js"
+
+const COLUMNS = ["id", "accountId", "planId", "status", "renewsAt", "graceUntil"]
+
+/** CSV of the subscriptions customers are currently billed for, for the finance team. */
+export function exportActiveCsv() {
+  return toCsv(allSubscriptions().filter((row) => row.status === "active"), COLUMNS)
+}
