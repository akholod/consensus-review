-const view = (row) => ({ id: row.id, name: row.name, priceCents: row.priceCents, interval: row.interval })
+const view = (row) => ({
+  id: row.id,
+  name: row.name,
+  priceCents: row.priceCents,
+  interval: row.interval,
+  includedUnits: row.includedUnits ?? 0,
+  unitCents: row.unitCents ?? 0,
+})
 
 export function getPlan(id) {
   const [row] = query("plans", { id })
@@ -10,3 +18,9 @@ export function getPlan(id) {
 export function listPlans() {
   return query("plans").map(view)
 }
+
+/** Price of the current period: the plan price plus every metered unit beyond the included ones. */
+export function periodPrice(planId, subscriptionId) {
+  const plan = getPlan(planId)
+  return plan.priceCents + Math.max(0, unitsUsed(subscriptionId) - plan.includedUnits) * plan.unitCents
+}
