@@ -19,3 +20,9 @@ export function unitsUsed(subscriptionId) {
 export function overLimit(subscriptionId) {
   return unitsUsed(subscriptionId) >= config.usageLimitPerPeriod
 }
+
+/** Records metered units, refusing them once the period's limit is reached. */
+export function meter(subscriptionId, units) {
+  if (overLimit(subscriptionId)) throw new HttpError(429, "usage_limit")
+  record(subscriptionId, units)
+}
diff --git a/test/plans.test.js b/test/plans.test.js
new file mode 100644
index 0000000..4b9f45a
--- /dev/null
+++ b/test/plans.test.js
@@ -0,0 +1,14 @@
+import assert from "node:assert/strict"
+import { test } from "node:test"
+import { createAccount } from "../src/accounts/index.js"
+import { periodPrice } from "../src/plans/index.js"
+import { startSubscription } from "../src/subscriptions/index.js"
+import { record } from "../src/usage/index.js"
+import { NOW, seedPlan } from "./helpers.js"
+
+test("charges metered units beyond the included ones", () => {
+  const planId = seedPlan({ id: "metered", includedUnits: 100, unitCents: 2 })
+  const id = startSubscription(createAccount({ name: "Cy", email: "cy@example.com" }), planId, NOW)
+  record(id, 150)
+  assert.equal(periodPrice(planId, id), 2000)
+})
