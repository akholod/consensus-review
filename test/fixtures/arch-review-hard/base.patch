+import { overLimit, record } from "../usage/index.js"
+import { HttpError, toResponse } from "./errors.js"
+
+export function postUsageHandler(req) {
+  try {
+    if (overLimit(req.params.id)) throw new HttpError(429, "usage_limit")
+    record(req.params.id, req.body.units)
+    return { status: 204, body: null }
+  } catch (err) {
+    return toResponse(err)
+  }
+}
