diff --git a/src/usage/index.js b/src/usage/index.js
new file mode 100644
index 0000000..d43bcdb
--- /dev/null
+++ b/src/usage/index.js
@@ -0,0 +1,21 @@
+import { on } from "../infra/bus.js"
+import { config } from "../infra/config.js"
+import { insert, query, update } from "../infra/db.js"
+import { getSubscription } from "../subscriptions/index.js"
+
+on("subscription.renewed", ({ subscriptionId }) => update("usage", { subscriptionId }, { units: 0 }))
+
+export function record(subscriptionId, units) {
+  if (getSubscription(subscriptionId)?.status !== "active") throw new Error(`subscription ${subscriptionId} is not active`)
+  const [row] = query("usage", { subscriptionId })
+  if (row) update("usage", { subscriptionId }, { units: row.units + units })
+  else insert("usage", { subscriptionId, units })
+}
+
+export function unitsUsed(subscriptionId) {
+  return query("usage", { subscriptionId })[0]?.units ?? 0
+}
+
+export function overLimit(subscriptionId) {
+  return unitsUsed(subscriptionId) >= config.usageLimitPerPeriod
+}
