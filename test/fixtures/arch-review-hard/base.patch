new file mode 100644
index 0000000..8189750
--- /dev/null
+++ b/src/infra/registry.js
@@ -0,0 +1,12 @@
+// Named providers, wired in src/app.js, so a module can depend on a capability, not a vendor.
+const providers = new Map()
+
+export function provide(name, impl) {
+  providers.set(name, impl)
+}
+
+export function use(name) {
+  const impl = providers.get(name)
+  if (!impl) throw new Error(`no provider for ${name}`)
+  return impl
+}
