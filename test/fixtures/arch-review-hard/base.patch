diff --git a/src/subscriptions/index.js b/src/subscriptions/index.js
new file mode 100644
index 0000000..f630583
--- /dev/null
+++ b/src/subscriptions/index.js
@@ -0,0 +1,49 @@
+import { getAccount } from "../accounts/index.js"
+import { publish } from "../infra/bus.js"
+import { config } from "../infra/config.js"
+import { DAY } from "../infra/time.js"
+import { getPlan } from "../plans/index.js"
+import { allSubscriptions, findByAccount, findSubscription, patchSubscription, saveSubscription } from "./repository.js"
+
+let seq = 0
+const view = (row) => ({ id: row.id, accountId: row.accountId, planId: row.planId, status: row.status, renewsAt: row.renewsAt })
+
+export function startSubscription(accountId, planId, now = Date.now()) {
+  if (!getAccount(accountId)) throw new Error(`unknown account ${accountId}`)
+  const plan = getPlan(planId)
+  if (!plan) throw new Error(`unknown plan ${planId}`)
+  const id = `sub_${++seq}`
+  saveSubscription({ id, accountId, planId, status: "active", renewsAt: now + plan.interval * DAY, graceUntil: null })
+  return id
+}
+
+export function getSubscription(id) {
+  const row = findSubscription(id)
+  return row ? view(row) : null
+}
+
+/** Subscriptions the account is still billed for: active ones and those inside their grace period. */
+export function listActive(accountId) {
+  return findByAccount(accountId).filter((row) => row.status === "active" || row.status === "past_due").map(view)
+}
+
+export function dueForRenewal(now = Date.now()) {
+  return allSubscriptions().filter((row) => row.status === "active" && row.renewsAt <= now).map(view)
+}
+
+export function markRenewed(id, now = Date.now()) {
+  const row = findSubscription(id)
+  const renewsAt = now + getPlan(row.planId).interval * DAY
+  patchSubscription(id, { status: "active", renewsAt, graceUntil: null })
+  publish("subscription.renewed", { subscriptionId: id, accountId: row.accountId, periodEnd: renewsAt })
+}
+
+export function markPastDue(id, now = Date.now()) {
+  patchSubscription(id, { status: "past_due", graceUntil: now + config.renewalGrace * DAY })
+}
+
+export function cancel(id) {
+  const row = findSubscription(id)
+  patchSubscription(id, { status: "cancelled" })
+  publish("subscription.cancelled", { subscriptionId: id, accountId: row.accountId })
+}
