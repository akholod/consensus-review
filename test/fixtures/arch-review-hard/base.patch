@@ -0,0 +1,13 @@
+import { getAccount, updateAccount } from "../accounts/index.js"
+import { HttpError, toResponse } from "./errors.js"
+
+export function patchAccountHandler(req) {
+  try {
+    if (!getAccount(req.params.id)) throw new HttpError(404, "not_found")
+    const patch = Object.fromEntries(Object.entries({ name: req.body.name, email: req.body.email }).filter(([, v]) => v !== undefined))
+    updateAccount(req.params.id, patch)
+    return { status: 200, body: getAccount(req.params.id) }
+  } catch (err) {
+    return toResponse(err)
+  }
+}
