+import { request } from "./http.js"
+
+/** Charges the account through Stripe. Resolves to `{ id, status }`, `status` being "succeeded" or "failed". */
+export async function charge({ accountId, amountCents }) {
+  const res = await request("https://api.stripe.example/v1/charges", {
+    method: "POST",
+    body: { customer: accountId, amount: amountCents, currency: "eur" },
+  })
+  return { id: res.id, status: res.status }
+}
