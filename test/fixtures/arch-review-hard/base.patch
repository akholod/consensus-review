@@ -0,0 +1,28 @@
+import { publish } from "../infra/bus.js"
+import { findAccount, patchAccount, saveAccount } from "./repository.js"
+
+const settingsCache = new Map()
+let seq = 0
+
+export function createAccount({ name, email }) {
+  const id = `acc_${++seq}`
+  saveAccount({ id, name, email, settings: { channels: ["email"], locale: "en" } })
+  return id
+}
+
+export function getAccount(id) {
+  const row = findAccount(id)
+  return row ? { id: row.id, name: row.name, email: row.email } : null
+}
+
+export function getSettings(id) {
+  if (!settingsCache.has(id)) settingsCache.set(id, findAccount(id)?.settings ?? null)
+  const settings = settingsCache.get(id)
+  return settings && { ...settings, channels: [...settings.channels] }
+}
+
+export function updateAccount(id, patch) {
+  patchAccount(id, patch)
+  settingsCache.delete(id)
+  publish("account.updated", { account: getAccount(id) })
+}
