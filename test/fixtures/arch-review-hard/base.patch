+++ b/test/subscriptions.test.js
@@ -0,0 +1,19 @@
+import assert from "node:assert/strict"
+import { test } from "node:test"
+import { createAccount } from "../src/accounts/index.js"
+import { getSubscription, listActive, markPastDue, startSubscription } from "../src/subscriptions/index.js"
+import { NOW, seedPlan } from "./helpers.js"
+
+const planId = seedPlan()
+
+test("a new subscription renews one plan interval later", () => {
+  const id = startSubscription(createAccount({ name: "Ada", email: "ada@example.com" }), planId, NOW)
+  assert.equal(getSubscription(id).renewsAt, NOW + 30 * 24 * 60 * 60 * 1000)
+})
+
