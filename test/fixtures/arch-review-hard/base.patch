+export class HttpError extends Error {
+  constructor(status, code) {
+    super(code)
+    this.status = status
+    this.code = code
+  }
+}
+
+export function toResponse(err) {
+  return err instanceof HttpError ? { status: err.status, body: { error: err.code } } : { status: 500, body: { error: "internal" } }
+}
