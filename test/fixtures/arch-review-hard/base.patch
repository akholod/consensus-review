new file mode 100644
index 0000000..c9ee4e6
--- /dev/null
+++ b/src/invoicing/dunning.js
@@ -0,0 +1,8 @@
+import { config } from "../infra/config.js"
+import { DAY } from "../infra/time.js"
+
+/** Reminder times after a failed renewal: halfway through the grace period, and one day before it ends. */
+export function reminderTimes(failedAt) {
+  const grace = config.renewalGrace * DAY
+  return [failedAt + grace / 2, failedAt + grace - DAY]
+}
diff --git a/src/invoicing/index.js b/src/invoicing/index.js
new file mode 100644
index 0000000..5c14d71
--- /dev/null
+++ b/src/invoicing/index.js
@@ -0,0 +1,32 @@
+import { publish } from "../infra/bus.js"
+import { insert, query, update } from "../infra/db.js"
+import { use } from "../infra/registry.js"
+import { getPlan } from "../plans/index.js"
+import { dueForRenewal, markPastDue, markRenewed } from "../subscriptions/index.js"
+import { reminderTimes } from "./dunning.js"
+
+let seq = 0
+
+export async function renewDue(now = Date.now()) {
+  const results = []
+  for (const sub of dueForRenewal(now)) {
+    const { priceCents } = getPlan(sub.planId)
+    const invoiceId = `inv_${++seq}`
+    insert("invoices", { id: invoiceId, subscriptionId: sub.id, accountId: sub.accountId, amountCents: priceCents, status: "open" })
+    const charge = await use("payments").charge({ accountId: sub.accountId, amountCents: priceCents })
+    if (charge.status === "succeeded") {
+      update("invoices", { id: invoiceId }, { status: "paid", chargeId: charge.id })
+      markRenewed(sub.id, now)
+      publish("invoice.paid", { invoiceId, accountId: sub.accountId, amountCents: priceCents })
+    } else {
+      update("invoices", { id: invoiceId }, { status: "failed", remindAt: reminderTimes(now) })
+      markPastDue(sub.id, now)
+    }
+    results.push({ invoiceId, status: charge.status })
+  }
+  return results
+}
+
+export function invoicesFor(accountId) {
+  return query("invoices", { accountId }).map((row) => ({ id: row.id, amountCents: row.amountCents, status: row.status, remindAt: row.remindAt ?? null }))
+}
