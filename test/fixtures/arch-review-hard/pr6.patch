+++ b/src/api/plans-handler.js
@@ -0,0 +1,10 @@
+import { comparePlans, listPlans } from "../plans/index.js"
+import { toResponse } from "./errors.js"
+
+export function getPlansHandler() {
+  try {
+    return { status: 200, body: comparePlans(listPlans()) }
+  } catch (err) {
+    return toResponse(err)
+  }
+}
diff --git a/src/plans/compare.js b/src/plans/compare.js
new file mode 100644
index 0000000..62237f6
--- /dev/null
+++ b/src/plans/compare.js
@@ -0,0 +1,6 @@
+/** The plans from cheapest to dearest per month, each with its price per 30 days in cents. */
+export function comparePlans(plans) {
+  return plans
+    .map((plan) => ({ ...plan, monthlyCents: Math.round((plan.priceCents * 30) / plan.interval) }))
+    .sort((a, b) => a.monthlyCents - b.monthlyCents)
+}
