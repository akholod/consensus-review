diff --git a/test/plans-compare.test.js b/test/plans-compare.test.js
new file mode 100644
index 0000000..30107ce
--- /dev/null
+++ b/test/plans-compare.test.js
@@ -0,0 +1,10 @@
+import assert from "node:assert/strict"
+import { test } from "node:test"
+import { comparePlans, listPlans } from "../src/plans/index.js"
+import { seedPlan } from "./helpers.js"
+
+test("orders plans by price per 30 days", () => {
+  seedPlan({ id: "monthly", priceCents: 1900, interval: 30 })
+  seedPlan({ id: "yearly", priceCents: 19000, interval: 365 })
+  assert.deepEqual(comparePlans(listPlans()).map((p) => [p.id, p.monthlyCents]), [["yearly", 1562], ["monthly", 1900]])
+})
