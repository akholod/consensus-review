@@ -0,0 +1,10 @@
+import { request } from "./http.js"
+
+/** Charges the account through Adyen. Resolves to `{ pspReference, resultCode }`. */
+export async function charge({ accountId, amountCents }) {
+  const res = await request("https://checkout.adyen.example/v71/payments", {
+    method: "POST",
+    body: { shopperReference: accountId, amount: { value: amountCents, currency: "EUR" } },
+  })
+  return { pspReference: res.pspReference, resultCode: res.resultCode }
+}
