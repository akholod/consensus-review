--- /dev/null
+++ b/src/invoicing/voids.js
@@ -0,0 +1,9 @@
+import { query, update } from "../infra/db.js"
+
+/** Voids an invoice that was never paid, and ends the subscription it billed. */
+export function voidInvoice(invoiceId) {
+  const [invoice] = query("invoices", { id: invoiceId })
+  if (!invoice || invoice.status === "paid") throw new Error(`invoice ${invoiceId} cannot be voided`)
+  update("invoices", { id: invoiceId }, { status: "void" })
+  update("subscriptions", { id: invoice.subscriptionId }, { status: "cancelled" })
+}
